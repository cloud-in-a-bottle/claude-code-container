#!/usr/bin/env bash
#
# Runs a command inside the namespace the workbench itself runs in — the nested user, mount and
# cgroup namespaces that nested-podman.sh creates so that podman works here. Every terminal the
# workbench opens is already inside it, so this is only needed by something that arrived from
# outside: a `podman exec` into this container from the host lands in pid 1's namespaces, which are
# the ones openhost gave us, and podman does not work there.
#
#     podman exec -it openhost-claude-workbench workbench-ns podman ps
#
# Joining is allowed because the namespace's owner is uid 0 of the namespace we are in, which the
# kernel grants every capability over its children.

set -euo pipefail

pid_file=/run/workbench-namespace.pid

if [ "$#" -eq 0 ]; then
    echo "usage: workbench-ns <command> [args...]" >&2
    exit 2
fi

if [ ! -r "$pid_file" ]; then
    echo "workbench-ns: $pid_file is missing — the workbench is not running inside a namespace of" \
        "its own, so you are already in the only one there is. See /app/nested-podman.sh." >&2
    exit 1
fi

# --preserve-credentials because nsenter otherwise drops to the target's uid *before* joining, and
# uid 0 outside the namespace is the only identity the join is permitted to.
exec nsenter --target "$(cat "$pid_file")" --user --mount --cgroup --preserve-credentials "$@"
